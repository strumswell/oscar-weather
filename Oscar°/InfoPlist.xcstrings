    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr auf ca. 100 m gerundeter Standort wird verwendet, um Wetter und astronomische Hinweise anzuzeigen, und dazu an open-meteo.com sowie astro.oscars.love übermittelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location, rounded to about 100 m, is used to show weather and astronomy notices and is sent to open-meteo.com and astro.oscars.love."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık 100 m'ye yuvarlanan konumunuz hava durumu ve astronomi bildirimlerini göstermek için kullanılır; open-meteo.com ile astro.oscars.love'a iletilir."
          }
        }
      }
    },
