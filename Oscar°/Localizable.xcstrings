        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar uses radar data from the Agencia Estatal de Meteorología (AEMET), Spain's state meteorological agency, for the rain radar over the Canary Islands. Use does not imply endorsement by or official affiliation with AEMET."
