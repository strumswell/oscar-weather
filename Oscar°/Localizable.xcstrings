    "Komposit der beiden AEMET-Radare auf Gran Canaria und Teneriffa über den Kanarischen Inseln. In Tallagen kann der Teide einzelne Sektoren abschatten." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komposit der beiden AEMET-Radare auf Gran Canaria und Teneriffa über den Kanarischen Inseln. In Tallagen kann der Teide einzelne Sektoren abschatten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Composite of the two AEMET radars on Gran Canaria and Tenerife, covering the Canary Islands. At low levels Mount Teide can block individual sectors."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gran Canaria ve Tenerife'deki iki AEMET radarının Kanarya Adaları'nı kapsayan kompoziti. Alçak seviyelerde Teide bazı sektörleri gölgeleyebilir."
          }
        }
      }
    },
