    "Begrenzt Hoch/Tief auf einen Zeitraum, z. B. für relevantere Tiefstwerte nach Sonnenaufgang." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt Hoch/Tief auf einen Zeitraum, z. B. für relevantere Tiefstwerte nach Sonnenaufgang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limits high/low to a time period, for example to make lows after sunrise more relevant."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En yüksek/en düşük değerleri bir zaman aralığıyla sınırlar; örneğin güneş doğduktan sonraki düşük değerleri daha anlamlı hale getirir."
          }
        }
      }
    },
    "Bei diesem UV-Wert besteht nur eine geringe gesundheitliche Gefährdung. Meist sind keine besonderen Schutzmaßnahmen erforderlich." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei diesem UV-Wert besteht nur eine geringe gesundheitliche Gefährdung. Meist sind keine besonderen Schutzmaßnahmen erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At this UV level, the health risk is low. In most cases, no special protective measures are needed."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu UV değerinde sağlık riski düşüktür. Çoğu durumda özel bir korunma önlemi gerekmez."
          }
        }
      }
    },
