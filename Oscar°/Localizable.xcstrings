    },
    "Both beta alert types are currently turned off. They are available for Central Europe and the United States." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Beta-Warnungstypen sind derzeit ausgeschaltet. Sie sind für Mitteleuropa, die USA und Taiwan verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both beta alert types are currently turned off. They are available for Central Europe, the United States, and Taiwan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her iki beta uyarı türü de şu anda kapalı. Bunlar Orta Avrupa, ABD ve Tayvan için kullanılabilir."
          }
        }
      }
    },
    "Both beta alert types are currently turned off. They are available in Europe, the United States, Taiwan, and Brazil (rain alerts only)." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Beta-Warnungsarten sind derzeit ausgeschaltet. Verfügbar sind sie in Europa, den USA, Taiwan und Brasilien (nur Regenwarnungen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both beta alert types are currently turned off. They are available in Europe, the United States, Taiwan, and Brazil (rain alerts only)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
