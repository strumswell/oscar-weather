    "Ein Ensemble vergleicht mehrere leicht unterschiedliche Modellläufe. Dadurch wird sichtbar, wie stabil oder unsicher die Vorhersage in den nächsten Tagen ist." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ensemble vergleicht mehrere leicht unterschiedliche Modellläufe. Dadurch wird sichtbar, wie stabil oder unsicher die Vorhersage in den nächsten Tagen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An ensemble compares several slightly different model runs. This makes it visible how stable or uncertain the forecast is over the coming days."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir topluluk, birbirine yakın birkaç model çalışmasını karşılaştırır. Bu sayede önümüzdeki günlerde tahminin ne kadar kararlı ya da belirsiz olduğu görünür hale gelir."
          }
        }
      }
    },
    "Ein klarer Wetterbericht mit allem, was für deinen Tag zählt." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein klarer Wetterbericht mit allem, was für deinen Tag zählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A clear weather report with everything that matters for your day."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gününüz için önemli olan her şeyi içeren net bir hava durumu raporu."
          }
        }
      }
    },
    "Ein Wetterbericht mit allem, was Du wissen musst." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wetterbericht mit allem, was Du wissen musst."
