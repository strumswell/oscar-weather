    "Dein Standort verlässt dein Gerät nur auf ca. 100 m gerundet – ohne Konto, ohne Tracking." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort verlässt dein Gerät nur auf ca. 100 m gerundet – ohne Konto, ohne Tracking."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location leaves your device only rounded to about 100 m. No account, no tracking."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumunuz cihazınızdan yalnızca yaklaşık 100 m'ye yuvarlanmış olarak çıkar – hesap yok, takip yok."
          }
        }
      }
    },
    "Dein Standort verlässt dein Gerät nur auf ca. 100 m gerundet und wird nur für eine Sache verwendet: dein Wetter." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort verlässt dein Gerät nur auf ca. 100 m gerundet und wird nur für eine Sache verwendet: dein Wetter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location leaves your device only rounded to about 100 m, and it is used for one thing only: your weather."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konumunuz cihazınızdan yalnızca yaklaşık 100 m'ye yuvarlanarak çıkar ve tek bir şey için kullanılır: hava durumunuz."
          }
        }
      }
    },
