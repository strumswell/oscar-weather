    "Oscar° bündelt präzise Vorhersagen, Echtzeit-Radar und Klimadaten – werbefrei und ohne Konto." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar° bündelt präzise Vorhersagen, Echtzeit-Radar und Klimadaten – werbefrei und ohne Konto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar° brings together precise forecasts, real-time radar, and climate data, ad-free and without an account."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar° hassas tahminleri, gerçek zamanlı radarı ve iklim verilerini bir araya getirir – reklamsız ve hesap gerektirmeden."
          }
        }
      }
    },
    "Oscar° bündelt präzise Vorhersagen, Echtzeit-Radar und Klimadaten verschiedener Wetterdienste." : {
