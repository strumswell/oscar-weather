          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar° brings together precise forecasts, real-time radar, and climate data from a range of weather services."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar° farklı meteoroloji servislerinin hassas tahminlerini, gerçek zamanlı radarını ve iklim verilerini bir araya getirir."
          }
        }
      }
    },
