          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar uses radar data from REDEMET (DECEA), Brazil's aeronautical meteorology network, for the rain radar over Brazil. Use does not imply endorsement by or official affiliation with REDEMET or DECEA."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar, Brezilya üzerindeki yağmur radarı için Brezilya havacılık meteoroloji ağı REDEMET'in (DECEA) radar verilerini kullanır. Kullanım, REDEMET veya DECEA ile bir destek veya resmi bağlantı anlamına gelmez."
          }
        }
      }
    },
    "Oscar verwendet Wetter- und Geodaten des Deutschen Wetterdienstes (DWD), unter anderem Radardaten sowie Prognosedaten aus dem ICON-D2-Modell. Datenbasis: Deutscher Wetterdienst. Die Daten werden unter den Open-Data-Nutzungsbedingungen des DWD bereitgestellt." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar verwendet Wetter- und Geodaten des Deutschen Wetterdienstes (DWD), unter anderem Radardaten sowie Prognosedaten aus dem ICON-D2-Modell. Datenbasis: Deutscher Wetterdienst. Die Daten werden unter den Open-Data-Nutzungsbedingungen des DWD bereitgestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar uses weather and geodata from the German Weather Service (DWD), including radar data and forecast data from the ICON-D2 model. Data source: German Weather Service. The data is provided under the DWD Open Data Terms of Use."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar, Alman Meteoroloji Servisi (DWD) tarafından sağlanan hava durumu ve coğrafi verileri kullanır; buna radar verileri ve ICON-D2 modelinden alınan tahmin verileri de dahildir. Veri kaynağı: Alman Meteoroloji Servisi. Veriler, DWD Açık Veri Kullanım Koşulları kapsamında sağlanmaktadır."
          }
        }
      }
    },
    "Oscar verwendet Wetter- und Geodaten des Deutschen Wetterdienstes (DWD), unter anderem Radardaten, Prognosedaten aus dem ICON-Modell sowie amtliche Warnmeldungen. Datenbasis: Deutscher Wetterdienst. Die Daten werden unter den Open-Data-Nutzungsbedingungen des DWD bereitgestellt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar verwendet Wetter- und Geodaten des Deutschen Wetterdienstes (DWD), unter anderem Radardaten, Prognosedaten aus dem ICON-Modell sowie amtliche Warnmeldungen. Datenbasis: Deutscher Wetterdienst. Die Daten werden unter den Open-Data-Nutzungsbedingungen des DWD bereitgestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oscar uses weather and geodata from the German Meteorological Service (DWD), including radar data, forecast data from the ICON model, and official warnings. Data basis: Deutscher Wetterdienst. The data is provided under the DWD open data terms of use."
          }
        },
