    "app_icon_ai_disclosure" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle App-Symbole außer dem originalen App-Symbol wurden mit Hilfe von KI-Tools erstellt. Wenn du Designer:in bist oder einfach Lust hast, ein eigenes App-Symbol beizusteuern, schreib mir an design@bolte.id."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All app icons except the original app icon were created with the help of AI tools. If you are a designer or just an enthusiast who would be willing to create a custom app icon, write me at design@bolte.id."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orijinal uygulama simgesi dışındaki tüm uygulama simgeleri yapay zeka araçlarının yardımıyla oluşturuldu. Tasarımcıysanız ya da özel bir uygulama simgesi hazırlamak isteyen bir meraklıysanız bana design@bolte.id adresinden yazın."
          }
        }
      }
    },
    "app_icon_error_change_failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS konnte das App-Symbol nicht auf %1$@ setzen. Aktuelles Symbol: %2$@. Fehler: %3$@ (%4$@ %5$ld)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS could not change the app icon to %1$@. Current icon: %2$@. Error: %3$@ (%4$@ %5$ld)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS uygulama simgesini %1$@ olarak değiştiremedi. Geçerli simge: %2$@. Hata: %3$@ (%4$@ %5$ld)"
          }
        }
      }
    },
    "app_icon_error_system_prompt_unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS konnte die Systemabfrage zum Ändern des App-Symbols nicht öffnen. Das passiert häufig im Simulator. Bitte App neu öffnen und erneut versuchen. Aktuelles Symbol: %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS could not open the system prompt for changing the app icon. This often happens in the simulator. Please reopen the app and try again. Current icon: %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS uygulama simgesini değiştirmek için sistem istemini açamadı. Bu durum simülatörde sık görülür. Lütfen uygulamayı yeniden açıp tekrar deneyin. Geçerli simge: %@."
          }
        }
      }
    },
