{
  "sourceLanguage" : "de",
  "strings" : {
    "Berechtigungen verwaltet iOS: Beim ersten Aktivieren fragt Oscar direkt an, danach öffnet der Schalter die passende Stelle in den iOS-Einstellungen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigungen verwaltet iOS: Beim ersten Aktivieren fragt Oscar direkt an, danach öffnet der Schalter die passende Stelle in den iOS-Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS manages these permissions: the first time you turn one on, Oscar asks directly; after that, the switch opens the right place in iOS Settings."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu izinleri iOS yönetir: Bir izni ilk kez açtığınızda Oscar doğrudan sorar; sonrasında anahtar, iOS Ayarları'nda ilgili yeri açar."
          }
        }
      }
    },
